{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sveltia-oauth-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  "routes": [
    {
      "pattern": "xiaoguaiguai.cn/oauth/*",
      "zone_name": "xiaoguaiguai.cn"
    }
  ]
}
