{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaoguaiguai-media-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xiaoguaiguai-media"
    }
  ],
  "routes": [
    {
      "pattern": "xiaoguaiguai.cn/media/*",
      "zone_name": "xiaoguaiguai.cn"
    }
  ]
}
